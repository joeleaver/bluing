// A small Bluing script. It is also valid Rust.

struct Enemy {
    name: &'static str,
    hp: i32,
}

impl Enemy {
    fn new(name: &'static str, hp: i32) -> Enemy {
        Enemy { name, hp }
    }

    fn name(&self) -> &str {
        self.name
    }

    fn take_hit(&mut self, dmg: i32) -> bool {
        self.hp -= dmg;
        self.hp <= 0
    }
}

/// Hits every enemy and returns how many were defeated.
fn hit_all(enemies: &mut [Enemy; 2], dmg: i32) -> i32 {
    let mut defeated = 0;
    let mut i = 0;
    while i < 2 {
        if enemies[i].take_hit(dmg) {
            defeated += 1;
        }
        i += 1;
    }
    defeated
}

fn main() {
    let mut enemies = [Enemy::new("slime", 3), Enemy::new("bat", 1)];
    let defeated = hit_all(&mut enemies, 2);
    let first = enemies[0].name();
    let _ = (defeated, first);
}
